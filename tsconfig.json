{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/index.js",
    "scripts/build/*.mjs",
    "supabase/functions/_shared/*.mjs"
  ]
}